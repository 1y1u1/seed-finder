# ---- Qt / 构建环境 (体积巨大, 不进版本库) ----
_env/
_tools/
_deploy/
_build/
_build3/
_build_static/
_archive/

# ---- 编译中间产物与可执行文件 ----
*.obj
*.exe
*.ilk
*.pdb
*.idb
*.exp
*.lib
*.dll
*.res
moc_*
qrc_*
ui_*
Makefile
Makefile.*
.qmake.stash
*.vcxproj*
release/
debug/
.sconsign/

# ---- 运行期/临时产物 (只忽略根目录与构建目录下的截图, 源码目录里的资源要留) ----
/*.png
/*.txt

# 本地构建脚本, 只在本机用
/build.ps1

# ---- 不进主线的目录 ----
# _bench: 本地基准与回归工具, 只在本机用, 不上传
# zombie_calculator-master: 第三方参考项目, 不上传
# seed-finder-qt-main1.2: 1.2 / 2.0 版旧源码, 只在 legacy-2.0 分支上保留
/_bench/
/zombie_calculator-master/
/seed-finder-qt-main1.2/
/_ssh/

# GPU 后端的源码在 gpu 分支入库; main 分支上这个目录根本不存在。
# 只忽略构建产物 (nvcc/qmake 的 obj、release/、日志、Makefile)。
# 用 _gpu/* 而不是 /_gpu/ —— 整个目录忽略掉的话 add -f 也要一个一个来。
/_gpu/Makefile*
/_gpu/.qmake.stash
/_gpu/*.obj
/_gpu/release/
/_gpu/debug/
/_gpu/*.log

# ---- 编辑器 / 系统 ----
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini
